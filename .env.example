PORT=3000
# Bind to loopback by default; override to 0.0.0.0 only in a container or prod env
# where external reachability is required.
HOST=127.0.0.1
LOG_LEVEL=info
# How long shutdown waits for in-flight reviews before halting.
SHUTDOWN_TIMEOUT_MS=240000

# Output language for review findings and replies. Set to "ru" (or any natural-language name)
# to force a specific language; default is English.
REVIEW_LANGUAGE=en

# Delete review runs and snapshot data older than this many days (POST /cleanup).
CLEANUP_RETENTION_DAYS=90
# Bearer token required by POST /cleanup. Leave empty and the endpoint is not registered
# at all, which is the safe default. Minimum 32 characters when set.
CLEANUP_TOKEN=

# Comma-separated workspace package prefixes to skip during library/doc resolution.
# Example: "@workspace/,@internal/" — imports starting with these are not sent to context7.
WORKSPACE_PACKAGE_PREFIXES=

# Append a token/cost footer to the posted review summary.
SHOW_REVIEW_COST_FOOTER=false

# --- Code host selection ---
# One of: gitlab | github
CODE_HOST_PROVIDER=gitlab

# --- Code host: GitLab ---
GITLAB_API_URL=https://gitlab.example.com/api/v4
GITLAB_TOKEN=
GITLAB_BOT_USERNAME=ai

# --- Code host: GitHub ---
GITHUB_API_URL=https://api.github.com
GITHUB_BOT_USERNAME=ai
# Auth option A: a token (personal or installation access token)
GITHUB_TOKEN=
# Auth option B: a GitHub App (mints short-lived installation tokens)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Private key: either inline PEM (GITHUB_APP_PRIVATE_KEY) or a path to the .pem
# file kept OUTSIDE the repo (recommended). Set one, not both — an empty inline
# value shadows the path.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- LLM PROVIDER ---
# One of: openrouter | ollama
LLM_PROVIDER=openrouter

# --- OpenRouter (or any OpenAI-compatible endpoint) ---
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_TRIAGE_MODEL=minimax/minimax-m2.7
# Switch backend without code changes by pointing the URL at any OpenAI-compatible
# chat-completions endpoint (and using that provider's key + model slugs). Examples:
#   OpenRouter (default): https://openrouter.ai/api/v1/chat/completions
#   DeepSeek direct:      https://api.deepseek.com/v1/chat/completions  (model: deepseek-chat)
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# --- Ollama (local or Cloud) ---
# Local:  OLLAMA_BASE_URL=http://localhost:11434 (no key needed)
# Cloud:  OLLAMA_BASE_URL=https://ollama.com (key required, format: ollama_...)
# Cloud keys: https://ollama.com/settings/keys
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
# Cloud example: gpt-oss:120b-cloud
# Local example: qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_TRIAGE_MODEL=qwen3:8b

# --- Webhook ---
# Shared secret used to verify incoming webhook signatures. REQUIRED: the app refuses
# to start without it.
WEBHOOK_SECRET=
# Set to false ONLY for a self-hosted deployment on a trusted network where the code host
# cannot sign its deliveries. Unsigned webhooks are then accepted from anyone who can
# reach the port.
WEBHOOK_SIGNATURE_REQUIRED=true
# Max queued jobs before the webhook returns 503.
WEBHOOK_MAX_QUEUE_SIZE=150

DATABASE_URL=postgresql://ai_reviewer:ai_reviewer@localhost:5433/ai_reviewer

# --- Documentation context (context7) ---
CONTEXT7_API_KEY=
CONTEXT7_BASE_URL=https://context7.com
CONTEXT7_ENABLED=true
CONTEXT7_MAX_TOKENS=2500

# --- Review pipeline limits ---
# Hard ceiling on estimated spend for a single review run. Unset means no ceiling.
REVIEW_MAX_COST_USD=
# Global inline posting threshold (env only; not read from REVIEW.md).
SEVERITY_THRESHOLD=info
# Optional. Local file with review rules when REVIEW.md is missing in the target repo.
RULES_FALLBACK_PATH=

# Inject CLAUDE.md/package.json/src/ excerpts from the target repo into the system prompt of every
# file-review pass. ON by default (the cross-file/architectural pass is a core selling feature).
# Set to false to save ~10k tokens per file when project context is not needed.
ARCHITECTURE_SNAPSHOT_ENABLED=true
ARCHITECTURE_SNAPSHOT_MAX_FILE_CHARS=8000
ARCHITECTURE_SNAPSHOT_MAX_LIST_FILES=200
ARCHITECTURE_SNAPSHOT_MAX_TOTAL_CHARS=40000

# Prompt size ceilings per pass, in characters.
REVIEW_TRIAGE_PROMPT_HARD_LIMIT=5000
REVIEW_FILE_PROMPT_HARD_LIMIT=10000
REVIEW_CROSS_FILE_PROMPT_HARD_LIMIT=12000
FILE_REVIEW_MAX_DIFF_CHARACTERS=60000

# Replies to review-thread comments.
COMMENT_RESPONSE_MAX_DIFF_LENGTH=200000
COMMENT_RESPONSE_MAX_TOOL_ROUNDS=3
COMMENT_RESPONSE_PROMPT_HARD_LIMIT=8000
FINDING_THREAD_PROMPT_HARD_LIMIT=12000
FINDING_THREAD_ARCHITECTURE_SNAPSHOT_MAX_TOTAL_CHARS=12000
THREAD_PRIOR_FINDINGS_MAX_CHARS=4000

# Limits for overlay codebase tools (list_files line cap, search_content files/matches per file).
OVERLAY_MAX_LIST_FILES=200
OVERLAY_MAX_MATCHES_PER_FILE=5
OVERLAY_MAX_READ_FILE_CHARS=6000
OVERLAY_MAX_READ_FILE_LINES=300
OVERLAY_MAX_SEARCH_RESULTS=20
OVERLAY_MAX_TOOL_RESPONSE_CHARS=8000

# Incremental review across pushes.
FORCE_PUSH_LINE_WINDOW=20
FORCE_PUSH_LINE_MATCH_TAB_WIDTH=4
LINE_SHIFT_DEDUP_TOLERANCE=3

# Baseline snapshot readiness before a review starts.
REVIEW_BASELINE_POLL_MS=400
REVIEW_BASELINE_READY_TIMEOUT_MS=900000

# A run still in_progress after this long is treated as stuck and reclaimed.
RUN_STUCK_AFTER_MS=1800000
