{
  "name": "@gkosach/core",
  "version": "0.1.0",
  "description": "Open-source AI code-review pipeline: anchor-grounded, multi-pass, self-hostable.",
  "license": "BUSL-1.1",
  "author": "German Kosach",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./server": {
      "default": "./dist/index.js"
    }
  },
  "main": "dist/public.js",
  "types": "dist/public.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "db:migrate": "dotenv -e .env tsx src/infrastructure/database/migrate.ts",
    "db:snapshot": "dotenv -e .env -- tsx scripts/db-snapshot.ts",
    "dev": "dotenv -e .env tsx src/index.ts | pino-pretty -t",
    "dev:ollama": "LLM_PROVIDER=ollama dotenv -e .env tsx src/index.ts | pino-pretty -t",
    "dev:raw": "dotenv -e .env tsx src/index.ts",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "install:gitHooks": "git config core.hooksPath .git-hooks || echo 'Not in a git repo'",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "monitor": "tsx scripts/monitor-review.ts",
    "prepare": "pnpm run build",
    "replay": "dotenv -e .env -- tsx scripts/replay-mr.ts",
    "scan": "dotenv -e .env -- tsx scripts/replay-mr.ts",
    "smoke:llm": "dotenv -e .env tsx scripts/smoke-llm.ts",
    "smoke:llm:ollama": "LLM_PROVIDER=ollama dotenv -e .env tsx scripts/smoke-llm.ts",
    "smoke:llm:openrouter": "LLM_PROVIDER=openrouter dotenv -e .env tsx scripts/smoke-llm.ts",
    "smoke:triage": "dotenv -e .env tsx scripts/triage-smoke.ts | pino-pretty -t",
    "start": "node dist/index.js",
    "test": "vitest run --project unit --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "trace": "tsx scripts/trace-review.ts",
    "types:check": "tsc --noEmit",
    "uninstall:gitHooks": "git config --unset core.hooksPath || echo 'Not in a git repo'"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "fastify": "5.5.0",
    "kysely": "0.28.15",
    "minimatch": "10.2.5",
    "p-queue": "9.1.2",
    "pg": "8.16.3",
    "pino": "8.10.0",
    "prom-client": "15.1.3",
    "tar-stream": "^3.1.8",
    "typed-inject": "5.0.0",
    "yaml": "2.8.3",
    "zod": "4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tsconfig/node24": "24.0.1",
    "@tsconfig/strictest": "2.0.5",
    "@types/node": "24.2.1",
    "@types/pg": "8.16.0",
    "@types/tar-stream": "^3.1.4",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv-cli": "10.0.0",
    "eslint": "9.32.0",
    "pino-pretty": "9.2.0",
    "prettier": "3.6.2",
    "prettier-plugin-packagejson": "2.5.19",
    "testcontainers": "10.25.0",
    "tsc-alias": "1.8.15",
    "tsx": "4.20.5",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
