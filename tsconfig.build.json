{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "rootDir": "src",
    "sourceMap": false
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.e2e.test.ts",
    "src/test-utils/**"
  ],
  "include": ["src"]
}
